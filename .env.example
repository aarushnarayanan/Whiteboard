PORT=3001
DATABASE_URL=postgres://whiteboard:whiteboard@localhost:5432/whiteboard
JWT_SECRET=

# the client's own origin — used to build links (e.g. password reset) that
# point back at the app. Set to the real deployed URL in production.
APP_URL=http://localhost:5173

# added when image upload is wired up
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# added when a real email provider is wired up in server/src/email/sendEmail.ts
# — until EMAIL_API_KEY is set, emails (e.g. password reset links) are just
# logged to the server console instead of sent.
EMAIL_FROM=
EMAIL_API_KEY=
